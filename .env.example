MARIADB_DATABASE=bomaveda
MARIADB_USER=bomaveda
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
# 32 random bytes, base64. Generate: docker run --rm php:8.5-cli php -r 'echo base64_encode(random_bytes(32));'
APP_KEY=
# USSD: the shortcode shown in the demo, a secret for the gateway URL (leave blank to turn the gateway off), and the demo phone on/off
USSD_CODE="*519*41#"
USSD_TOKEN=
SIM_ENABLED=1
# Public deployment only: your domain, for example demo.example.org
DOMAIN=localhost
